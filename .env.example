NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Prefer the newer publishable key. Legacy anon key still works as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used only by pnpm setup:family (never commit real private emails to source)
TURNER_SAM_EMAIL=sam@example.com
TURNER_MICHELLE_EMAIL=michelle@example.com
TURNER_FAMILY_NAME=Turner Family

# Optionally set to false only after later migration phases.
USE_LOCAL_STORE=true

# Research library Phase 1.5:
# Production uses Supabase tables + private bucket research-sources.
# Apply supabase/migrations/0004_research_library.sql and
# 0005_research_storage_policies.sql, then optionally:
#   pnpm upload:research-library
#
# Local-dev filesystem fallback only (ignored on Vercel):
# USE_LOCAL_RESEARCH_STORE=true

# --- Trip Online Mode (temporary; server-only — never NEXT_PUBLIC_) ---
# EMERGENCY_ACCESS_MODE=true
# EMERGENCY_ACCESS_CODE=replace-with-long-shared-code
# EMERGENCY_COOKIE_SECRET=replace-with-long-random-secret
# USE_REMOTE_JSON_STORE=true
