NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used only by pnpm setup:family (never commit real private emails to source)
TURNER_SAM_EMAIL=sam@example.com
TURNER_MICHELLE_EMAIL=michelle@example.com
TURNER_FAMILY_NAME=Turner Family

# Phase 1 product data still uses the local JSON store after Auth.
# Set to false only after later migration phases.
USE_LOCAL_STORE=true
